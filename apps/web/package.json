{
  "name": "@grimorio/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/app/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs dist dist-ssr",
    "build:test": "vite build --mode test --outDir dist-test && vite build --mode test --ssr src/app/entry-server.tsx --outDir dist-ssr-test && node scripts/prerender.mjs dist-test dist-ssr-test",
    "build:spa": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "preview:test": "vite preview --outDir dist-test --port 4180 --strictPort",
    "size": "size-limit"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@grimorio/rules": "workspace:*",
    "@grimorio/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@size-limit/file": "^14.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "size-limit": "^14.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
