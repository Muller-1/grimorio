# Copie para apps/api/.env e ajuste. Validado em src/config/env.ts.
APP_ENV=local
DATABASE_URL=postgres://app:app@localhost:5432/app_dev
PORT=3000
LOG_LEVEL=info

# ---- Login (ADR-008) ----
# Endereço do SITE. A API é acessada por baixo dele, em /api (o Vite repassa para a porta 3000).
SITE_URL=http://localhost:5173
# Segredo que assina os cookies de sessão (32+ caracteres). Este valor de exemplo só vale no
# computador; em staging/produção a API se recusa a subir com ele. Para gerar um novo:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=troque-este-segredo-local-por-um-com-32-caracteres-ou-mais
# Credenciais do Google Cloud (Clientes OAuth → Aplicativo da Web). NUNCA vão para o Git.
# Redirecionamento autorizado no Google: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Outras origens que podem usar o login, separadas por vírgula (ex.: a prévia em :4173).
# TRUSTED_ORIGINS=http://localhost:4173

# API de teste (/__test__/*). Nunca em produção. Token com 32+ caracteres.
# ENABLE_TEST_API=true
# TEST_API_TOKEN=troque-por-um-segredo-com-32-caracteres-ou-mais

# Publicado (ADR-009): segredo combinado com o repasse /api do site (32+ caracteres). No
# computador fica vazio. No Render ele é gerado sozinho (render.yaml).
# PROXY_SECRET=
